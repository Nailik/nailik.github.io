    <string name="project_bialetti_title">Bialetti Elektrikka</string>
    <string name="project_bialetti_description">Modifikation einer Bialetti Eletrikka zur Temperaturregelung.</string>
    <string name="project_bialetti_description_long">Modifikation einer Bialetti Eletrikka Mokkakanne zur präzisen Temperatursteuerung.\nDas Projekt nutzt mehrere TSiC-Temperatursensoren, die an einen ESP32-Mikrocontroller angeschlossen sind.\nEin auf dem ESP32 laufender Webserver ermöglicht die Live-Überwachung von Temperatur und Heizleistung.</string>
    <string name="project_bialetti_bullet_card_key_features_title">Hauptfunktionen</string>
    <string name="project_bialetti_bullet_card_key_features_item_0">Eigene Leiterplatte: Beherbergt den ESP32 und die Sensoranschlüsse.</string>
    <string name="project_bialetti_bullet_card_key_features_item_1">C++ Firmware (PlatformIO): Liest die Temperatursensoren aus und steuert das Heizelement.</string>
    <string name="project_bialetti_bullet_card_key_features_item_2">Webserver-Oberfläche: Zeigt Temperaturdaten in Echtzeit im Browser an.</string>
    <string name="project_bialetti_bullet_card_key_features_item_3">3D-gedruckte Basis: Zur Integration der Leiterplatte und Sensoren in die Maschine.</string>
    <string name="project_bialetti_bullet_card_0_title">Skills &amp; Lerninhalte</string>
    <string name="project_bialetti_bullet_card_0_item_0">Embedded-Firmware-Entwicklung (C++ / PlatformIO).</string>
    <string name="project_bialetti_bullet_card_0_item_1">Leiterplattendesign und Hardwareintegration.</string>
    <string name="project_bialetti_bullet_card_0_item_2">Webserver-Implementierung auf einem Mikrocontroller.</string>
    <string name="project_bialetti_bullet_card_0_item_3">Mechanische Anpassung mittels 3D-Druck.</string>
    <string name="project_bialetti_bullet_card_0_item_4">Systemintegration aus Hardware, Firmware und Benutzeroberfläche.</string>
    <string name="project_diyscale_title">DIY Waage</string>
    <string name="project_diyscale_description">Sehr dünne DIY-Waage mit Bluetooth und WLAN – ausgelegt für den Einsatz an einer Kaffeemaschine.</string>
    <string name="project_diyscale_description_long">Kompakte und präzise DIY-Kaffeewaage mit ESP32-Mikrocontroller sowie Bluetooth- und WLAN-Anbindung. Sie verfügt über ein kleines Display, Touch-Tasten und eine Weboberfläche zur Konfiguration und Anzeige von Live-Daten. Die Waage ist kompatibel mit der „ito“-Espresso-App.</string>
    <string name="project_diyscale_bullet_card_key_features_title">Hauptfunktionen</string>
    <string name="project_diyscale_bullet_card_key_features_item_0">ESP32-basiertes System mit Bluetooth- und WLAN-Konnektivität.</string>
    <string name="project_diyscale_bullet_card_key_features_item_1">Kompaktes, sehr flaches Design für Espresso-Setups.</string>
    <string name="project_diyscale_bullet_card_key_features_item_2">Weboberfläche für Live-Messungen und Konfiguration über den Browser.</string>
    <string name="project_diyscale_bullet_card_key_features_item_3">Touch-Tasten und Display zur direkten lokalen Bedienung.</string>
    <string name="project_diyscale_bullet_card_key_features_item_4">Bluetooth-Verbindung kompatibel zur ito-App für Automatisierung.</string>
    <string name="project_diyscale_bullet_card_key_features_item_5">Open-Source-Projekt mit verfügbarer Firmware, Weboberfläche und 3D-Modellen.</string>
